# 이 파일을 복사해 .env.local 로 만든 뒤 값을 채웁니다. (.env.local 은 Git에 올라가지 않습니다)

# [선택] 실제 도로 경로·이동시간 (OpenRouteService). 없으면 직선 연결선 모드로만 동작합니다.
# 무료 키 발급: https://openrouteservice.org/dev/#/signup  (서버 전용 — NEXT_PUBLIC_ 를 붙이지 마세요)
ORS_API_KEY=

# [선택] 지도 스타일 URL (기본: OpenFreeMap Liberty)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# [선택] Vercel Web Analytics 사용 여부 (true 일 때만 로드). Vercel 대시보드에서 Analytics를 먼저 켜세요.
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# [선택] QR/공유 링크의 기준 주소. 비워 두면 현재 접속 주소를 사용합니다.
NEXT_PUBLIC_SITE_URL=

# [데이터 갱신용 · 선택] 소상공인시장진흥공단 상가(상권)정보 API 일반 인증키(Decoding)
# 웹 앱 실행/배포에는 필요 없습니다. scripts/data-pipeline/fetch_places.py 로 data/places.csv 를 다시 만들 때만 사용합니다.
# 공공데이터포털 → "소상공인시장진흥공단_상가(상권)정보" → 활용신청 후 발급 (Vercel 에 등록하지 마세요)
SEMAS_SERVICE_KEY=
